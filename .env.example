# CareCircle Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# ─── Database ────────────────────────────────────────────────────────────────
# Full async SQLAlchemy DSN (postgresql+asyncpg)
DATABASE_URL=postgresql+asyncpg://carecircle:carecircle@db:5432/carecircle

# ─── JWT / Security ──────────────────────────────────────────────────────────
# 64-character random string used to sign JWT access/refresh tokens
JWT_SECRET=change-me-to-64-random-chars

# 64-character random string used to sign one-time action tokens (email links)
ACTION_TOKEN_SECRET=change-me-to-64-random-chars

# Access token lifetime in minutes (default 30)
ACCESS_TOKEN_MINUTES=30

# Refresh token lifetime in days (default 7)
REFRESH_TOKEN_DAYS=7

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:3000

# ─── Email (MailHog in dev, real SMTP in prod) ────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@carecircle.local

# ─── Telegram Bot ─────────────────────────────────────────────────────────────
# Token from BotFather; leave blank to disable Telegram notifications
TELEGRAM_BOT_TOKEN=
# Shared secret for validating Telegram webhook requests
TELEGRAM_WEBHOOK_SECRET=

# ─── Vision / OCR ─────────────────────────────────────────────────────────────
# Provider: "fake" (dev stub), "google", "openai"
VISION_PROVIDER=fake
VISION_API_KEY=

# ─── Intent Classifier ────────────────────────────────────────────────────────
# Path to a local ONNX / TFLite model; leave blank to use rule-based fallback
INTENT_CLASSIFIER_PATH=

# ─── Worker / Scheduler ───────────────────────────────────────────────────────
# How often the background worker ticks (seconds)
TICK_SECONDS=30
# How many minutes before a dose the first reminder fires
REMINDER_LEAD_MINUTES=30
# Default grace window (minutes) before a dose is marked missed
DEFAULT_GRACE_MINUTES=60

# ─── Environment ──────────────────────────────────────────────────────────────
# "dev" | "staging" | "prod"
ENV=dev
